# Xorg.wrap policy (xserver-xorg-legacy). Installed to /etc/X11/Xwrapper.config.
#
# `retrobox boot` starts Xorg through xinit from retrobox-boot.service on tty1
# whenever a QEMU VM runs. The appliance has no logind sessions, so Xorg needs
# root rights to become DRM master and open input devices. `anybody` rather
# than `console`: the service user is the only account (and already has
# sudo), and the console check would depend on Xorg's stdin being the VT
# through systemd and xinit.
allowed_users=anybody
needs_root_rights=yes
