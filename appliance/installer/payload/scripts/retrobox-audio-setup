#!/usr/bin/env bash
set -Eeuo pipefail

target=/data/home/retrobox/.asoundrc
detected=""
for eld in /proc/asound/card*/eld#*; do
    [ -f "$eld" ] || continue
    grep -q '^monitor_present[[:space:]]*:[[:space:]]*1' "$eld" || continue
    card_dir="${eld%/eld#*}"
    card_id="$(cat "$card_dir/id" 2>/dev/null || true)"
    for pcm in "$card_dir"/pcm*p/id; do
        [ -f "$pcm" ] || continue
        grep -qi HDMI "$pcm" || continue
        device="${pcm##*/pcm}"
        detected="$card_id|${device%%p/id}"
        break 2
    done
done

if [ -z "$detected" ]; then
    for pcm in /proc/asound/card*/pcm*p/id; do
        [ -f "$pcm" ] || continue
        card_dir="${pcm%/pcm*}"
        card_id="$(cat "$card_dir/id" 2>/dev/null || true)"
        [ -n "$card_id" ] || continue
        device="${pcm##*/pcm}"
        detected="$card_id|${device%%p/id}"
        break
    done
fi

[ -n "$detected" ] || exit 0
IFS='|' read -r card_id device <<< "$detected"
case "$card_id" in ''|*[!A-Za-z0-9_-]*) exit 0 ;; esac

install -d -o retrobox -g retrobox -m 0755 "$(dirname "$target")"
cat > "$target" <<EOF
# Generated by retrobox-audio-setup.service.
pcm.!default {
    type plug
    slave.pcm "plughw:CARD=$card_id,DEV=$device"
}
ctl.!default {
    type hw
    card $card_id
}
EOF
chown retrobox:retrobox "$target"
chmod 0644 "$target"
