#!/usr/bin/env bash
# First-boot WiFi configuration for the RetroBox appliance.
#
# Detects a wl* interface, prompts for SSID + password on first boot with
# dialog, persists them to /data/system/wifi.conf, and materializes a
# systemd-networkd [WiFi] config into /run/systemd/network so the read-only
# root is never written at runtime. The prompt runs once; every boot the
# networkd file is regenerated from the persisted credentials.
set -Eeuo pipefail

# --- Logging (mirrors appliance/installer/lib/common.sh) --------------------

_c_reset=$'\033[0m'; _c_blue=$'\033[1;34m'; _c_yellow=$'\033[1;33m'
_c_red=$'\033[1;31m'

log()  { printf '%s[*]%s %s\n' "$_c_blue"  "$_c_reset" "$*" >&2; }
warn() { printf '%s[!]%s %s\n' "$_c_yellow" "$_c_reset" "$*" >&2; }
err()  { printf '%s[x]%s %s\n' "$_c_red"   "$_c_reset" "$*" >&2; }
die()  { err "$*"; exit 1; }

# --- Constants ---------------------------------------------------------------

WIFI_CONF_DIR=/data/system
CREDS=$WIFI_CONF_DIR/wifi.conf
MARKER=$WIFI_CONF_DIR/wifi-configured
NETWORKD_DIR=/run/systemd/network
NETWORKD_FILE=$NETWORKD_DIR/30-wifi.network
# shellcheck disable=SC2125 # glob is expanded intentionally at the probe below
WIFI_IFACE_RE=/sys/class/net/wl*

# --- Early exit: no WiFi NIC -------------------------------------------------

# shellcheck disable=SC2086 # intentional glob probe for any wl* interface
if ! ls $WIFI_IFACE_RE >/dev/null 2>&1; then
    log "No WiFi interface detected; skipping."
    exit 0
fi

mkdir -p "$WIFI_CONF_DIR"

# --- First-boot prompt -------------------------------------------------------

if [ ! -f "$CREDS" ] || [ ! -f "$MARKER" ]; then
    # Plymouth owns the splash until retrobox-boot.service; quit it before we
    # prompt so the dialog is visible.
    plymouth quit --retain-splash 2>/dev/null || true

    SSID=""
    while [ -z "$SSID" ]; do
        SSID=$(dialog --stdout --inputbox "WiFi network name (SSID):" 8 60) || SSID=""
    done

    PSK=""
    PSK2=""
    while true; do
        PSK=$(dialog --stdout --insecure --passwordbox "WiFi password:" 8 60) || PSK=""
        [ -n "$PSK" ] || continue
        PSK2=$(dialog --stdout --insecure --passwordbox "Confirm password:" 8 60) || PSK2=""
        if [ "$PSK" != "$PSK2" ]; then
            dialog --msgbox "Passwords did not match. Try again." 6 50 || true
            continue
        fi
        if [ "${#PSK}" -lt 8 ]; then
            # WPA2-PSK passphrases need at least 8 characters, but many real
            # networks use exactly 8 — warn instead of rejecting.
            warn "Password is shorter than 8 characters; WPA2-PSK requires at least 8."
            dialog --msgbox "Note: WPA2-PSK passwords should be at least 8 characters." 6 58 || true
        fi
        break
    done

    # Plain SSID=/PSK= lines; the parser below handles spaces and special
    # characters, so a manual edit (the documented re-config path) is safe too.
    printf 'SSID=%s\nPSK=%s\n' "$SSID" "$PSK" > "$CREDS"
    chmod 0600 "$CREDS"
    chown root:root "$CREDS"

    date -Iseconds > "$MARKER"
    chmod 0644 "$MARKER"
    chown root:root "$MARKER"

    unset PSK PSK2
fi

# --- Materialize the systemd-networkd [WiFi] config -------------------------

_materialize_network_file() {
    # Read key=value lines instead of sourcing: an SSID like "Home WiFi" is
    # valid and common, and sourcing would word-split it.
    SSID=""
    PSK=""
    while IFS= read -r line; do
        case "$line" in
            SSID=*) SSID=${line#SSID=} ;;
            PSK=*)  PSK=${line#PSK=} ;;
        esac
    done < "$CREDS"
    [ -n "$SSID" ] || die "wifi.conf is missing SSID"
    [ -n "$PSK" ] || die "wifi.conf is missing PSK"
    mkdir -p "$NETWORKD_DIR"
    {
        printf '[Match]\nName=wl*\n\n[Network]\nDHCP=yes\n\n[WiFi]\n'
        printf 'SSID=%s\n' "$SSID"
        printf 'PreSharedKey=%s\n' "$PSK"
    } > "$NETWORKD_FILE"
    chmod 0644 "$NETWORKD_FILE"
}

_materialize_network_file

systemctl restart systemd-networkd.service
log "WiFi configured for $SSID."
