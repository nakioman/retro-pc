#!/usr/bin/env bash
# First-boot WiFi configuration for the RetroBox appliance.
#
# Detects a wl* interface, prompts for SSID + password on first boot with
# dialog, persists them to /data/system/wifi.conf, and materializes the
# wpa_supplicant config + a slim systemd-networkd config into /run so the
# read-only root is never written at runtime. The prompt runs once; every
# boot the /run files are regenerated from the persisted credentials.
set -Eeuo pipefail

# --- Logging (mirrors appliance/installer/lib/common.sh) --------------------

_c_reset=$'\033[0m'; _c_blue=$'\033[1;34m'; _c_yellow=$'\033[1;33m'
_c_red=$'\033[1;31m'

log()  { printf '%s[*]%s %s\n' "$_c_blue"  "$_c_reset" "$*" >&2; }
warn() { printf '%s[!]%s %s\n' "$_c_yellow" "$_c_reset" "$*" >&2; }
err()  { printf '%s[x]%s %s\n' "$_c_red"   "$_c_reset" "$*" >&2; }
die()  { err "$*"; exit 1; }

# --- Constants ---------------------------------------------------------------

WIFI_CONF_DIR=/data/system
CREDS=$WIFI_CONF_DIR/wifi.conf
MARKER=$WIFI_CONF_DIR/wifi-configured
NETWORKD_DIR=/run/systemd/network
NETWORKD_FILE=$NETWORKD_DIR/30-wifi.network
# shellcheck disable=SC2125 # glob is expanded intentionally at the probe below
WIFI_IFACE_RE=/sys/class/net/wl*

# --- Early exit: no WiFi NIC -------------------------------------------------

# shellcheck disable=SC2086 # intentional glob probe for any wl* interface
if ! ls $WIFI_IFACE_RE >/dev/null 2>&1; then
    log "No WiFi interface detected; skipping."
    exit 0
fi

mkdir -p "$WIFI_CONF_DIR"

# --- First-boot prompt -------------------------------------------------------

if [ ! -f "$CREDS" ] || [ ! -f "$MARKER" ]; then
    # Plymouth owns the framebuffer; full quit (no --retain-splash) so the
    # dialog can draw on tty1.
    plymouth quit 2>/dev/null || true

    SSID=""
    while [ -z "$SSID" ]; do
        SSID=$(dialog --stdout --inputbox "WiFi network name (SSID):" 8 60) || SSID=""
    done

    PSK=""
    PSK2=""
    while true; do
        PSK=$(dialog --stdout --insecure --passwordbox "WiFi password:" 8 60) || PSK=""
        [ -n "$PSK" ] || continue
        PSK2=$(dialog --stdout --insecure --passwordbox "Confirm password:" 8 60) || PSK2=""
        if [ "$PSK" != "$PSK2" ]; then
            dialog --msgbox "Passwords did not match. Try again." 6 50 || true
            continue
        fi
        if [ "${#PSK}" -lt 8 ]; then
            # WPA2-PSK passphrases need at least 8 characters, but many real
            # networks use exactly 8 — warn instead of rejecting.
            warn "Password is shorter than 8 characters; WPA2-PSK requires at least 8."
            dialog --msgbox "Note: WPA2-PSK passwords should be at least 8 characters." 6 58 || true
        fi
        break
    done

    # Plain SSID=/PSK= lines; the parser below handles spaces and special
    # characters, so a manual edit (the documented re-config path) is safe too.
    printf 'SSID=%s\nPSK=%s\n' "$SSID" "$PSK" > "$CREDS"
    chmod 0600 "$CREDS"
    chown root:root "$CREDS"

    date -Iseconds > "$MARKER"
    chmod 0644 "$MARKER"
    chown root:root "$MARKER"

    unset PSK PSK2
fi

# --- Materialize the wpa_supplicant + systemd-networkd config ---------------

# Resolve the real interface name. systemd-networkd's [Match] uses globs but
# wpa_supplicant needs the exact name. Glob matches wlan0 / wlpXsYuZ / wlx<mac>.
# shellcheck disable=SC2012 # intentional glob resolution of the wl* interface
IFACE=$(ls -d /sys/class/net/wl* 2>/dev/null | head -n1) || true
IFACE=${IFACE##*/}
[ -n "$IFACE" ] || die "no wl* interface found despite detection probe"

# Read SSID/PSK from wifi.conf (unchanged parser).
SSID=""; PSK=""
while IFS= read -r line; do
    case "$line" in
        SSID=*) SSID=${line#SSID=} ;;
        PSK=*)  PSK=${line#PSK=} ;;
    esac
done < "$CREDS"
[ -n "$SSID" ] || die "wifi.conf is missing SSID"
[ -n "$PSK" ]  || die "wifi.conf is missing PSK"

# C-style escape for double-quote and backslash so the wpa_supplicant config
# stays valid when SSID/PSK contain those characters.
_wpa_escape() {
    printf '%s' "$1" | sed 's/["\\]/\\&/g'
}

# 1) wpa_supplicant config — /run, regenerated every boot.
mkdir -p /run/wpa_supplicant
{
    printf 'ctrl_interface=DIR=/run/wpa_supplicant GROUP=root\n'
    printf 'update_config=1\n'
    printf 'network={\n'
    printf '\tssid="%s"\n' "$(_wpa_escape "$SSID")"
    printf '\tpsk="%s"\n' "$(_wpa_escape "$PSK")"
    printf '\tkey_mgmt=WPA-PSK\n'
    printf '}\n'
} > /run/wpa_supplicant/wifi.conf
chmod 0600 /run/wpa_supplicant/wifi.conf

# 2) Supervised supplicant unit, also under /run/systemd (re-materialized
#    every boot; systemd loads units from /run/systemd/system).
mkdir -p /run/systemd/system
{
    printf '[Unit]\n'
    printf 'Description=RetroBox WiFi supplicant (%s)\n' "$IFACE"
    printf 'After=systemd-networkd.service\n\n'
    printf '[Service]\n'
    printf 'Type=simple\n'
    printf 'ExecStart=/sbin/wpa_supplicant -D nl80211 -i %s -c /run/wpa_supplicant/wifi.conf\n' "$IFACE"
    printf 'Restart=on-failure\n'
    printf 'RestartSec=5\n'
} > /run/systemd/system/wpa-wifi.service
chmod 0644 /run/systemd/system/wpa-wifi.service

# 3) networkd config — note: NO [WiFi] section; systemd.network has no such
#    section and no PreSharedKey= key (match-only SSID= lives in [Match]).
{
    printf '[Match]\nName=wl*\n\n[Network]\nDHCP=yes\n'
} > "$NETWORKD_FILE"
chmod 0644 "$NETWORKD_FILE"

systemctl daemon-reload
systemctl restart wpa-wifi.service
systemctl restart systemd-networkd.service
log "WiFi configured for $SSID on $IFACE."
