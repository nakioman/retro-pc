[Unit]
Description=RetroBox WiFi first-boot configuration
Documentation=https://github.com/nakioman/retro-pc
After=local-fs.target systemd-networkd.service plymouth-start.service
Before=retrobox-boot.service
# Recovery: a GRUB entry that appends "retropc.norun=1" skips the fullscreen VM
# path; the wifi prompt must follow the same gate so a maintenance session can
# boot straight to a login.
ConditionKernelCommandLine=!retropc.norun
# Plymouth owns the splash until retrobox-boot.service; quit it before we prompt.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/retrobox-wifi-firstboot
StandardInput=tty
StandardOutput=tty
StandardError=journal

[Install]
WantedBy=multi-user.target
