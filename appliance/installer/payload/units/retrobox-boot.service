[Unit]
Description=RetroBox fullscreen boot launcher (default VM / F12 selector)
Documentation=https://github.com/nakioman/retro-pc
RequiresMountsFor=/data
After=local-fs.target retrobox-daemon.service
# Recovery: a GRUB entry that appends "retropc.norun=1" skips the fullscreen VM
# path and leaves a normal login on tty1 for maintenance.
ConditionKernelCommandLine=!retropc.norun
# Skip cleanly if the immutable runtime was not installed, so tty1 shows a
# normal login instead of a failing service restart loop.
ConditionPathExists=/opt/retrobox/retrobox
ConditionPathExists=/opt/86Box/86box.AppImage
ConditionPathIsDirectory=/opt/86Box/roms

# Own tty1 instead of a login prompt on the appliance's primary display.
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
ExecCondition=/usr/bin/test -x /opt/retrobox/retrobox
ExecCondition=/usr/bin/test -x /opt/86Box/86box.AppImage
User=retrobox
Group=retrobox
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=tty
StandardError=journal
# `retrobox boot` owns VM selection: it starts the default VM after a one-second
# F12 window, or opens the selector when F12 is pressed.
ExecStart=/opt/retrobox/retrobox boot
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
