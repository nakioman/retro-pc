[Unit]
Description=RetroBox hardware integration daemon (ESP8266 floppy controller)
Documentation=https://github.com/nakioman/retro-pc
RequiresMountsFor=/data
After=local-fs.target
# Recovery: a GRUB entry that appends "retropc.norun=1" skips the fullscreen VM
# path and leaves a normal login on tty1 for maintenance.
ConditionKernelCommandLine=!retropc.norun
# Skip cleanly if the immutable runtime was not installed, instead of failing
# and restart-looping on the console.
ConditionPathExists=/opt/retrobox/retrobox

[Service]
Type=simple
ExecCondition=/usr/bin/test -x /opt/retrobox/retrobox
User=retrobox
Group=retrobox
# Written by the installer (lib/hardware-detect.sh + lib/services.sh). Provides
# SERIAL_DEVICE, SERIAL_BAUD, and FLOPPY_CONTROL_SOCKET.
EnvironmentFile=/etc/retrobox/daemon.env
# The daemon reads serial protocol lines on stdin and drives the 86Box floppy
# control socket. Configure the serial line, then stream it into the daemon.
ExecStartPre=/bin/sh -c 'test -e "$SERIAL_DEVICE" && stty -F "$SERIAL_DEVICE" "$SERIAL_BAUD" raw -echo || true'
ExecStart=/bin/sh -c 'if [ -e "$SERIAL_DEVICE" ]; then exec /opt/retrobox/retrobox daemon --floppy-control-socket "$FLOPPY_CONTROL_SOCKET" < "$SERIAL_DEVICE"; else exec /opt/retrobox/retrobox daemon --floppy-control-socket "$FLOPPY_CONTROL_SOCKET"; fi'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
