[Unit]
Description=RetroBox hardware integration daemon (ESP8266 floppy controller)
Documentation=https://github.com/nakioman/retro-pc
RequiresMountsFor=/data
After=local-fs.target
# Recovery: a GRUB entry that appends "retropc.norun=1" skips the fullscreen VM
# path and leaves a normal login on tty1 for maintenance.
ConditionKernelCommandLine=!retropc.norun

[Service]
Type=simple
User=retrobox
Group=retrobox
# Fallback WEB_PORT in case daemon.env is from an older install (pre-panel).
# EnvironmentFile below may override it.
Environment=WEB_PORT=8080
# Written by the installer (lib/hardware-detect.sh + lib/services.sh). Provides
# SERIAL_DEVICE, SERIAL_BAUD, FLOPPY_CONTROL_SOCKET, and WEB_PORT.
EnvironmentFile=/etc/retrobox/daemon.env
# The daemon runs even with no floppy controller attached, serving the web panel
# on WEB_PORT. It opens the serial device itself (--serial-port/--serial-baud),
# drives the 86Box floppy control socket, and hosts the LAN floppy panel.
ExecStart=/opt/retrobox/retrobox daemon --serial-port "$SERIAL_DEVICE" --serial-baud "$SERIAL_BAUD" --floppy-control-socket "$FLOPPY_CONTROL_SOCKET" --web-port "$WEB_PORT"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
