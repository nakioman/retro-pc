[Unit]
Description=RetroBox hardware integration daemon (ESP8266 floppy controller)
Documentation=https://github.com/nakioman/retro-pc
RequiresMountsFor=/data
After=local-fs.target
# Recovery: a GRUB entry that appends "retropc.norun=1" skips the fullscreen VM
# path and leaves a normal login on tty1 for maintenance.
ConditionKernelCommandLine=!retropc.norun

[Service]
Type=simple
User=retrobox
Group=retrobox
# Written by the installer (lib/hardware-detect.sh + lib/services.sh). Provides
# SERIAL_DEVICE, SERIAL_BAUD, and FLOPPY_CONTROL_SOCKET.
EnvironmentFile=/etc/retrobox/daemon.env
# Skip the unit (without failing) when the floppy controller is not attached:
# with no SERIAL_DEVICE there is nothing for the daemon to watch. Exits 1-254
# from ExecCondition= leave the unit inactive, so Restart= is not triggered.
ExecCondition=/bin/sh -c 'test -e "$SERIAL_DEVICE"'
# The daemon opens the serial device itself (--serial-port/--serial-baud) and
# drives the 86Box floppy control socket.
ExecStart=/opt/retrobox/retrobox daemon --serial-port "$SERIAL_DEVICE" --serial-baud "$SERIAL_BAUD" --floppy-control-socket "$FLOPPY_CONTROL_SOCKET"
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
