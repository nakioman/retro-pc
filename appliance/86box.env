# Pinned emulator artifacts for the appliance (Debian amd64): 86Box and QEMU.
BOX86_VERSION="v7.0.0-master.111"
BOX86_APPIMAGE_NAME="86Box-SDL-x86_64-111.AppImage"
BOX86_APPIMAGE_URL="https://github.com/nakioman/86Box/releases/download/${BOX86_VERSION}/${BOX86_APPIMAGE_NAME}"
BOX86_APPIMAGE_SHA256="9266f1a8e784d465d1e0460e62ea3ed20aec7f4d99d39ed728050c098117c2e8"
BOX86_APPIMAGE_PATH="/opt/86Box/86box.AppImage"

BOX86_ROMS_VERSION="v6.0"
BOX86_ROMS_URL="https://api.github.com/repos/86Box/roms/tarball/${BOX86_ROMS_VERSION}"
BOX86_ROMS_SHA256="3686f4f0d315390b2e15268d44e7b4f6eb02fa27a4132c8d40ef604b031e4060"
BOX86_ROMS_PATH="/opt/86Box/roms"

# GLSL shader library pinned to a commit for reproducible installer images.
GLSL_SHADERS_COMMIT="235448f244bf676d135f7b25ea6b8e1eae41c4e4"
GLSL_SHADERS_URL="https://github.com/libretro/glsl-shaders/archive/${GLSL_SHADERS_COMMIT}.tar.gz"
GLSL_SHADERS_SHA256="9b791a0db8d2aa5fb9251800adb22525d9179b659f9f0137267204d9407cf5d6"
GLSL_SHADERS_PATH="/opt/86Box/shaders"

# QEMU for the Windows XP VM: our qemu-vmvga fork (branch `retrobox`), QEMU
# with the VMware SVGA II device, GTK + OpenGL display, and dxvk-native in lib/.
# QEMU dlopens DXVK, so it runs with LD_LIBRARY_PATH=${QEMU_PATH}/lib.
QEMU_VERSION="11.1.1"
QEMU_RELEASE="retrobox-11.1.1-1"
QEMU_ARCHIVE_NAME="qemu-retrobox-11.1.1-c894e78-linux-x86_64.tar.gz"
QEMU_URL="https://github.com/nakioman/qemu-vmvga/releases/download/${QEMU_RELEASE}/${QEMU_ARCHIVE_NAME}"
QEMU_SHA256="adb3f445336b4ff0e2e02ac3fd3cf1d64d881df74a2ff93af7b27ab0cc3f48d1"
QEMU_PATH="/opt/qemu-retrobox"
