<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="..\RetroBox.Core\RetroBox.Core.csproj" />
    <ProjectReference Include="..\RetroBox.Daemon\RetroBox.Daemon.csproj" />
    <ProjectReference Include="..\RetroBox.Web\RetroBox.Web.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>retrobox</AssemblyName>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- The appliance root ships no libicu; all parsing/formatting uses InvariantCulture. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
